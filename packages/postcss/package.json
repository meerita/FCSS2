{
  "name": "@fcss/postcss",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "FCSS PostCSS plugin — source scanning and production purge",
  "keywords": [
    "css",
    "utility",
    "fcss",
    "postcss",
    "purge"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@fcss/scanner": "workspace:*",
    "postcss": "^8.4.0"
  },
  "devDependencies": {
    "@fcss/core": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
