{
  "name": "@functionalcss/cli",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "FCSS command-line tool — build, purge, init, audit, and more",
  "keywords": [
    "css",
    "utility",
    "fcss",
    "cli"
  ],
  "license": "MIT",
  "author": "Diego Lafuente <diego.lafuente@cognativinc.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meerita/FCSS2.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/meerita/FCSS2/issues"
  },
  "homepage": "https://github.com/meerita/FCSS2/tree/master/packages/cli#readme",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "fcss": "dist/bin.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@functionalcss/generator": "workspace:*",
    "@functionalcss/scanner": "workspace:*",
    "@functionalcss/spec": "workspace:*",
    "commander": "^12.0.0",
    "jiti": "^2.0.0",
    "postcss": "^8.4.0"
  },
  "devDependencies": {
    "@functionalcss/postcss": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
