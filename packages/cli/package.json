{
  "name": "@fcss/cli",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "FCSS command-line tool — build, purge, init, audit, and more",
  "keywords": [
    "css",
    "utility",
    "fcss",
    "cli"
  ],
  "license": "MIT",
  "bin": {
    "fcss": "dist/bin.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@fcss/generator": "workspace:*",
    "@fcss/scanner": "workspace:*",
    "@fcss/spec": "workspace:*",
    "commander": "^12.0.0",
    "jiti": "^2.0.0",
    "postcss": "^8.4.0"
  },
  "devDependencies": {
    "@fcss/postcss": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
