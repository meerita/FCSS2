{
  "name": "@fcss/angular",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "FCSS Angular integration — ng add schematic for standalone and workspace projects",
  "keywords": [
    "css",
    "utility",
    "fcss",
    "angular",
    "schematic",
    "purge"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cognativinc/fcss"
  },
  "files": [
    "dist",
    "dist-schematics",
    "collection.json",
    "README.md",
    "LICENSE"
  ],
  "schematics": "./collection.json",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --build && tsc -p tsconfig.schematics.json && node -e \"const fs=require('fs');fs.writeFileSync('dist-schematics/package.json',JSON.stringify({type:'commonjs'}),'utf8')\"",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.schematics.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@angular/cli": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "@angular/core": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/cli": {
      "optional": false
    },
    "@angular/core": {
      "optional": false
    }
  },
  "devDependencies": {
    "@angular-devkit/core": "^18.0.0",
    "@angular-devkit/schematics": "^18.0.0",
    "@types/node": "^22.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
