{
  "name": "@functionalcss/astro",
  "version": "0.1.3",
  "private": false,
  "type": "module",
  "description": "FCSS Astro integration — registers @functionalcss/vite's plugin for production purge and dev diagnostics",
  "keywords": [
    "css",
    "utility",
    "fcss",
    "astro",
    "purge"
  ],
  "license": "MIT",
  "author": "Diego Lafuente <diego.lafuente@cognativinc.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meerita/FCSS2.git",
    "directory": "packages/astro"
  },
  "bugs": {
    "url": "https://github.com/meerita/FCSS2/issues"
  },
  "homepage": "https://github.com/meerita/FCSS2/tree/master/packages/astro#readme",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
