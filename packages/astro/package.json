  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "@functionalcss/core": "workspace:*",
    "@types/node": "^22.0.0",
    "astro": "^7.0.0",
    "typescript": "catalog:",
