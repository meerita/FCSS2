{
  "name": "@fcss/eslint-plugin",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "FCSS ESLint plugin — lint class attributes against the FCSS manifest",
  "keywords": [
    "css",
    "utility",
    "fcss",
    "eslint",
    "lint"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
