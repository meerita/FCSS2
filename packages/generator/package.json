{
  "name": "@fcss/generator",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "FCSS CSS generator — builds the full utility set from the FCSS spec",
  "keywords": [
    "css",
    "utility",
    "fcss",
    "generator"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run && playwright test",
    "test:unit": "vitest run",
    "test:browser": "playwright test",
    "generate": "node dist/cli.js"
  },
  "dependencies": {
    "@fcss/spec": "workspace:*",
    "postcss": "^8.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@types/node": "^22.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
