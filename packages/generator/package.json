    "generate": "node dist/cli.js"
  },
  "dependencies": {
    "@fcss/spec": "workspace:*",
    "postcss": "^8.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@types/node": "^22.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
