{
  "name": "@functionalcss/vite",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "description": "FCSS Vite plugin — source scanning, production purge, and dev diagnostics",
  "keywords": [
    "css",
    "utility",
    "fcss",
    "vite",
    "purge"
  ],
  "license": "MIT",
  "author": "Diego Lafuente <diego.lafuente@cognativinc.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meerita/FCSS2.git",
    "directory": "packages/vite"
  },
  "bugs": {
    "url": "https://github.com/meerita/FCSS2/issues"
  },
  "homepage": "https://github.com/meerita/FCSS2/tree/master/packages/vite#readme",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
