---
// @file examples/astro/server/src/pages/index.astro
// @description Server-rendered home page for the Astro server example fixture. Renders the
//   current server time to prove this route is executed per-request, not statically prerendered.
// @layer ui
// @created Diego Lafuente <diego.lafuente@cognativinc.com>

import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';

const renderedAt = new Date().toISOString();
---

<Layout title="FCSS Astro Server Example">
  <main
    class="display--flex flex-direction--column align-items--center gap--4 padding--16"
    data-testid="app-root"
  >
    <h1 class="font-size--xs font-weight--700 color--black" data-testid="app-heading">
      FCSS Astro Server Example
    </h1>
    <p data-testid="rendered-at">{renderedAt}</p>
    <Card
      title="FCSS Card"
      description="Demonstrates base, responsive, pseudo-state, and ARIA FCSS classes, server-rendered."
    />
  </main>
</Layout>
