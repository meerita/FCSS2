---
// @file examples/astro/static/src/pages/index.astro
// @description Home page for the Astro static example fixture.
// @layer ui
// @created Diego Lafuente <diego.lafuente@cognativinc.com>

import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
---

<Layout title="FCSS Astro Static Example">
  <main
    class="display--flex flex-direction--column align-items--center gap--4 padding--16"
    data-testid="app-root"
  >
    <h1 class="font-size--xs font-weight--700 color--black" data-testid="app-heading">
      FCSS Astro Static Example
    </h1>
    <Card
      title="FCSS Card"
      description="Demonstrates base, responsive, pseudo-state, and ARIA FCSS classes."
    />
  </main>
</Layout>
