---
// @file examples/astro/static/src/layouts/Layout.astro
// @description Base layout for the Astro static example fixture — imports FCSS full CSS.
// @layer ui
// @created Diego Lafuente <diego.lafuente@cognativinc.com>

import '@fcss/core/full.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
