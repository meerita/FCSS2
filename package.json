{
  "name": "fcss-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.6.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "generate": "pnpm --filter @fcss/generator run generate"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.3.0",
    "vite": "^6.0.0",
    "vitest": "^4.0.0"
  }
}
